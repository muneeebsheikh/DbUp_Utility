<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<appSettings>
		<!-- Local-dev defaults only. Release/CI: pass connectionString / DBUP_CONNECTION_STRING and scriptsPath / DBUP_SCRIPTS_PATH with yes or CI/TF_BUILD. Do not put double-hyphen flags inside this XML comment. -->
		<add key="ConnectionString" value="Data Source=localhost;Initial Catalog=DemoDb;Integrated Security=True;Encrypt=True;Trust Server Certificate=True" />
		<add key="ScriptsPath" value="Scripts\2026.17.00\" />
		<!-- Example ScriptsPath pointing at CUSTOMERINSIGHT dbo Tables (disabled). -->
		<!-- <add key="ScriptsPath" value="D:\Repository\Git Repos\CI_Workspace\CI_OnePlatform\database\CUSTOMERINSIGHT\dbo\Tables" /> -->
		<add key="ScriptFiles" value="" />
		<add key="ExcludeFiles" value="" />
		<add key="IncludeSubDirectories" value="true" />
		<!-- Log file or directory. Empty = Logs\\dbup-yyyyMMdd-HHmmss.log under the exe folder. -->
		<add key="LogFilePath" value="Logs" />
	</appSettings>
</configuration>